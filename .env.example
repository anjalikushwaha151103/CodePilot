# ==========================================
# CodePilot Environment Variables Template
# Copy this file to .env for local development
# NEVER commit real credentials to source control
# ==========================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=codepilot
POSTGRES_USER=codepilot_user
POSTGRES_PASSWORD=codepilot_dev_password
DATABASE_URL=jdbc:postgresql://localhost:5432/codepilot

# Cache Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend Application Configuration (Spring Boot 3)
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
SERVER_PORT=8080

# JWT Authentication
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI & Code Intelligence Service Configuration (FastAPI)
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# Web Dashboard Configuration (Next.js 14)
NEXT_PUBLIC_API_URL=http://localhost:8080
PORT=3000

# Browser Extension Configuration (Manifest V3)
EXTENSION_API_URL=http://localhost:8080
